<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PlanetMiner</AssemblyName>
    <RootNamespace>PlanetMiner</RootNamespace>
    <OutputType>Library</OutputType>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <!-- Where the game is installed. Override on the command line with
       -p:DSPGameRoot="D:\Steam\steamapps\common\Dyson Sphere Program". -->
  <PropertyGroup>
    <DSPGameRoot Condition="'$(DSPGameRoot)' == ''">E:\Game\Steam\steamapps\common\Dyson Sphere Program</DSPGameRoot>
    <DSPManaged Condition="'$(DSPManaged)' == ''">$(DSPGameRoot)\DSPGAME_Data\Managed</DSPManaged>
    <DSPCore Condition="'$(DSPCore)' == ''">$(DSPGameRoot)\BepInEx\core</DSPCore>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(DSPCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(DSPManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(DSPCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(DSPManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(DSPManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Copy the built plugin into the game and restart it.
       -p:DeployAfterBuild=false skips the copy, -p:LaunchGameAfterBuild=false keeps the game closed. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployAfterBuild)' != 'false'">
    <Exec Command="taskkill /f /im DSPGAME.exe &gt;nul 2&gt;&amp;1" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low" />
    <MakeDir Directories="$(DSPGameRoot)\BepInEx\plugins\$(AssemblyName)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DSPGameRoot)\BepInEx\plugins\$(AssemblyName)" />
    <Exec Condition="'$(LaunchGameAfterBuild)' != 'false'" Command="start steam://rungameid/1366540" IgnoreExitCode="true" />
  </Target>

</Project>
